# Copy to .env and adjust. docker-compose injects these for the container; this
# file is for running the API directly with `npm run start:dev`.

# HTTP
PORT=3000
# Absolute base URL the API is reachable at — used to build video URLs
# (videoUrl = ${PUBLIC_URL}/uploads/<file>). Must match how the app reaches it.
PUBLIC_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=synclog
DB_PASSWORD=synclog
DB_NAME=synclog
# Auto-create/update tables from entities. Convenient in dev; use migrations in
# production and set this to false.
DB_SYNC=true

# Auth — CHANGE THIS in any real deployment.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES=30d

# Public HTTPS via Caddy (optional). Only used by `docker compose --profile
# proxy up`. Set your domain here and point PUBLIC_URL at it (https, no port):
#   CADDY_DOMAIN=kimsvr7.ddns.net
#   PUBLIC_URL=https://kimsvr7.ddns.net
# CADDY_DOMAIN=

# Host bind address for the published API/DB ports. Defaults to 127.0.0.1
# (loopback) so neither is exposed to the internet — Caddy fronts the API over
# the internal network. Set to 0.0.0.0 only if you need direct LAN access.
# API_BIND=127.0.0.1
# DB_BIND=127.0.0.1
