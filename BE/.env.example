# Copy to .env and adjust. docker-compose injects these for the container; this
# file is for running the API directly with `npm run start:dev`.

# HTTP
PORT=3000
# Absolute base URL the API is reachable at — used to build video URLs
# (videoUrl = ${PUBLIC_URL}/uploads/<file>). Must match how the app reaches it.
PUBLIC_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=synclog
DB_PASSWORD=synclog
DB_NAME=synclog
# Auto-create/update tables from entities. Convenient in dev; use migrations in
# production and set this to false.
DB_SYNC=true

# Auth — CHANGE THIS in any real deployment.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES=30d
